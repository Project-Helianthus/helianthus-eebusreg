    {
      "id": "CR-COV-01",
      "description": "A certified release is a floor: a later release is covered, an earlier release is not, the certified release is.",
      "document": {
        "contract": "helianthus.semreg.certification-references/v1",
        "entries": [
          {
            "source": "certification",
            "category": "reference",
            "driver": "example-driver",
