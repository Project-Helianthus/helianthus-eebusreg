{
  "contract": "helianthus.semreg.certification-references-vectors/v1",
  "schema": "api/v1/certification-references-v1.schema.json",
  "vectors": [
    {
      "id": "CR-POS-01",
      "description": "A reference, a gap and an unavailable entry for three different models are accepted.",
      "document": {
        "contract": "helianthus.semreg.certification-references/v1",
        "entries": [
          {
            "source": "certification",
            "category": "reference",
            "driver": "example-driver",
            "vendor": "Example Vendor",
            "flavor": "example-profile",
            "model": "EX-1000",
            "firmware": {
              "form": "release",
              "release": "1.4.0"
            },
            "issuer": "Example Certification Body",
            "certificate_number": "EX-CERT-0001",
            "issue_date": "2000-01-15",
            "stated_value": {
              "measurement_type": "active_power",
              "ratio_maximum": {
                "coefficient": "1",
                "exponent10": -2
              }
            },
            "url": "https://example.invalid/registry/EX-CERT-0001",
            "retrieved_on": "2000-02-01"
          },
          {
            "source": "certification",
            "category": "gap",
            "driver": "example-driver",
            "vendor": "Example Vendor",
            "flavor": "example-profile",
            "model": "EX-2000",
            "firmware": {
              "form": "not_stated"
            },
            "issuer": "Example Certification Body",
            "url": "https://example.invalid/registry/search",
            "retrieved_on": "2000-02-01"
          },
          {
            "source": "certification",
            "category": "unavailable",
            "driver": "example-driver",
            "vendor": "Example Vendor",
            "flavor": "example-profile",
            "model": "EX-3000",
            "firmware": {
              "form": "not_stated"
            },
            "issuer": "Example Certification Body",
            "url": "https://example.invalid/registry/search",
            "retrieved_on": "2000-02-01",
            "refusal": "The registry answered that automated access is not permitted."
          }
        ]
      },
      "expected": {
        "accepted": true
      }
    },
    {
