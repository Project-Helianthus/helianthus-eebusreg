              "form": "release",
              "release": "1.4.0"
            },
            "issuer": "Example Certification Body",
            "certificate_number": "EX-CERT-0001",
            "issue_date": "2000-01-15",
            "stated_value": {
              "measurement_type": "active_power",
              "ratio_maximum": {
                "coefficient": "1",
                "exponent10": -2
              }
            },
            "url": "https://example.invalid/registry/EX-CERT-0001",
            "retrieved_on": "2000-02-01"
          }
        ]
      },
      "expected": {
        "accepted": true
      },
      "coverage": [
        {
          "entry": 0,
          "release": "1.4.0",
          "result": "covered"
        },
        {
          "entry": 0,
          "release": "1.4.1",
          "result": "covered"
        },
        {
          "entry": 0,
          "release": "2.0.0",
          "result": "covered"
        },
        {
          "entry": 0,
          "release": "1.3.9",
          "result": "not_covered"
        },
        {
          "entry": 0,
          "release": "0.9.0",
          "result": "not_covered"
        }
      ]
    },
    {
      "id": "CR-COV-02",
      "description": "A range with a stated upper bound covers its bounds and what lies between, and nothing beyond the upper bound.",
      "document": {
        "contract": "helianthus.semreg.certification-references/v1",
        "entries": [
          {
            "source": "certification",
            "category": "reference",
            "driver": "example-driver",
            "vendor": "Example Vendor",
